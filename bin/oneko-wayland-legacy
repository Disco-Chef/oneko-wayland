VARIANTS = ["neko", "tora", "dog", "sakura", "tomoyo"]


def color(value):
    v = value.strip().lower()
    if v in COLORS:
        return COLORS[v]
    if len(v) == 7 and v.startswith("#"):
        int(v[1:], 16)  # raises ValueError on junk
        return v
    raise argparse.ArgumentTypeError(
        f"{value!r} is not a CSS color name or #rrggbb")


def interval(value):
    ms = float(value)
    if ms >= 5000:  # old habits: oneko -time was in microseconds
        ms /= 1000
    return ms


def fps(value):
    rate = float(value)
    if not 0 < rate <= 50:
        raise argparse.ArgumentTypeError("fps must be between 1 and 50")
    return 1000 / rate


def sheet_path(value):
    """A web-neko sprite sheet: an 8x4 grid of frames in one PNG, the layout
    used by oneko.js and the skins on https://webneko.net/ and
    https://bomvel.neocities.org/neko/ (fan art; credit the artist named on
    the page where you found it)."""
    import os
    path = os.path.abspath(os.path.expanduser(value))
    if not os.path.isfile(path):
        raise argparse.ArgumentTypeError(f"no such file: {value}")
    return path


def call(method, *args, signature=""):
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    try:
        return bus.call_sync(
            BUS_NAME, OBJECT_PATH, BUS_NAME, method,
            GLib.Variant(f"({signature})", args) if args else None,
            None, Gio.DBusCallFlags.NONE, 2000, None)
    except GLib.Error as e:
        if "ServiceUnknown" in e.message or "NameHasNoOwner" in e.message:
            sys.exit(diagnose())
        sys.exit(f"oneko-wayland-legacy: D-Bus error: {e.message}")


def diagnose():
    """The extension isn't answering; figure out exactly why and say only
    the one step that fixes it."""
    import os

    user_dir = os.path.join(
        GLib.get_user_data_dir(), "gnome-shell", "extensions", UUID)
    system_dir = os.path.join("/usr/share/gnome-shell/extensions", UUID)
    installed = os.path.isdir(user_dir) or os.path.isdir(system_dir)

    settings = Gio.Settings.new("org.gnome.shell")
    enabled = UUID in settings.get_strv("enabled-extensions")
    extensions_off = settings.get_boolean("disable-user-extensions")

    why = "oneko-wayland-legacy: the cats' GNOME Shell extension is not running.\n"
    if not installed:
        return why + (
            "It is not installed. From a clone of the oneko-wayland repo, run:\n"
            "    ./install.sh")
    if extensions_off:
        return why + (
            "It is installed, but GNOME's global 'user extensions' switch is\n"
            "turned OFF, which silently disables it. Turn it back on with:\n"
            "    gsettings set org.gnome.shell disable-user-extensions false\n"
            "then log out and back in.")
    if not enabled:
        return why + (
            "It is installed but not enabled. Enable it with:\n"
            "    gnome-extensions enable " + UUID + "\n"
            "then log out and back in.")
    return why + (
        "It is installed and enabled; GNOME just hasn't loaded it yet,\n"
        "because a Wayland session only scans for new extensions at login.\n"
        "Log out and back in once, then run your command again.\n"
        "(One-time step: after that, your cats survive every login.)")


def cmd_add(args):
    config = {
        "name": args.name,
        "variant": args.variant,
        "fg": args.fg,
        "bg": args.bg,
        "speed": args.speed,
        "time": args.time,
        "offset": args.offset,
        "offsetY": args.offset_y,
        "wake": args.wake,
        "catch": args.catch,
        "mode": args.mode,
        "scale": args.scale,
        "sheet": args.sheet,
    }
    (result,) = call("AddCat", json.dumps(config), signature="s")
    result = json.loads(result)
    if "error" in result:
        sys.exit(f"oneko-wayland-legacy: {result['error']}")
    c = result["cat"]
    print(f"{c['name']} the {kind(c)} is on the prowl "
          f"({c['mode']} mode, fg {c['fg']}, bg {c['bg']})")


def kind(c):
    if c.get("sheet"):
        return os.path.splitext(os.path.basename(c["sheet"]))[0]
    return c["variant"]


def cmd_remove(args):
    if args.all:
        call("Clear")
        print("all cats sent home")
        return
    if not args.name:
        sys.exit("oneko-wayland-legacy: give a cat name or --all")
    (removed,) = call("RemoveCat", args.name, signature="s")
    if not removed:
        sys.exit(f"oneko-wayland-legacy: no cat named {args.name!r}")
    print(f"{args.name} sent home")


def cmd_list(_args):
    (cats,) = call("ListCats")
    cats = json.loads(cats)
    if not cats:
        print("no cats around")
        return
    for c in cats:
        print(f"{c['name']:12} {kind(c):7} mode={c['mode']:5} "
              f"body={c['bg']} outline={c['fg']} speed={c['speed']} "
              f"time={c['time']}ms offset={c['offset']:+},{c.get('offsetY', 0):+} "
              f"scale={c['scale']}")


def main():
    parser = argparse.ArgumentParser(
        prog="oneko-wayland-legacy",
        description="Desktop cats for GNOME on Wayland, in the spirit of oneko.")
    sub = parser.add_subparsers(dest="command", required=True)

    add = sub.add_parser("add", help="spawn a cat (replaces one with the same name)")
    add.add_argument("name", nargs="?", default="neko", help="the cat's name")
    add.add_argument("-a", "--animal", "-v", "--variant", dest="variant",
                     choices=VARIANTS, default="neko",
                     help="which animal to spawn (default: neko; tora is the "
                          "tiger-striped cat)")
    add.add_argument("--body", "--bg", dest="bg", metavar="COLOR", type=color, default="#ffffff",
                     help="body/fill color: CSS name or #rrggbb (default: white)")
    add.add_argument("--outline", "--fg", dest="fg", metavar="COLOR", type=color, default="#000000",
                     help="outline & details color: CSS name or #rrggbb "
                          "(default: black)")
    add.add_argument("-s", "--speed", type=float, default=13,
                     help="pixels covered per animation step (default: 13)")
    add.add_argument("--fps", dest="time", metavar="N", type=fps, default=argparse.SUPPRESS,
                     help="animation steps per second (default: 8)")
    add.add_argument("-t", "--time", dest="time", metavar="MS", type=interval, default=125,
                     help="alternative to --fps: step interval in ms; values "
                          ">= 5000 are read as oneko-style microseconds")
    add.add_argument("-o", "--offset-x", "--offset", dest="offset", metavar="PX", type=int,
                     default=0,
                     help="shift the cat's spot horizontally: positive = right, "
                          "negative = left, in px (default: 0)")
    add.add_argument("--offset-y", dest="offset_y", metavar="PX", type=int, default=0,
                     help="shift the cat's spot vertically: positive = down, "
                          "negative = up, in px (default: 0)")
    add.add_argument("--wake-distance", dest="wake", metavar="PX", type=float, default=6,
                     help="how far away (px) the target must be before a "
                          "resting cat gets up (default: 6; try 64 for a "
                          "lazier cat)")
    add.add_argument("--catch-distance", dest="catch", metavar="PX", type=float, default=6,
                     help="how close (px) the cat must get to consider the "
                          "target caught and sit down (default: 6)")
    add.add_argument("--sheet", type=sheet_path, metavar="PNG", default=None,
                     help="use a custom web-neko sprite sheet (8x4 grid PNG, "
                          "as found on webneko.net or the Neko Archive at "
                          "bomvel.neocities.org/neko) instead of a built-in "
                          "animal; --body/--outline then only color the name "
                          "tag")
    add.add_argument("-m", "--mode", choices=["focus", "mouse"], default="focus",
                     help="focus: ride the focused window's top edge (like "
                          "-tofocus); mouse: free pointer chasing (default: focus)")
    add.add_argument("--scale", type=float, default=1,
                     help="sprite scale factor (default: 1; try 2 on big screens)")
    add.set_defaults(func=cmd_add)

    remove = sub.add_parser("remove", help="remove a cat by name")
    remove.add_argument("name", nargs="?", help="the cat's name")
    remove.add_argument("--all", action="store_true", help="remove every cat")
    remove.set_defaults(func=cmd_remove)

    lst = sub.add_parser("list", help="list the cats currently out")
    lst.set_defaults(func=cmd_list)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
