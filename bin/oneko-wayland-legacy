#!/usr/bin/env python3
"""CLI for the Oneko Wayland GNOME Shell extension.

Talks to the extension over D-Bus (org.oneko.WaylandLegacy). Cats persist across
logins until you remove them.
"""

import argparse
import json
import os
import sys

import gi
from gi.repository import Gio, GLib

BUS_NAME = "org.oneko.WaylandLegacy"
OBJECT_PATH = "/org/oneko/WaylandLegacy"
UUID = "oneko-wayland-legacy@disco-chef"

